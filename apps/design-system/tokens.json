      { "fg": "{color.signal.fault}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.fault}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.change}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.change}", "bg": "{color.surface.raised}" }
    ]
  }
}
