    "$description": "The states of ELA. The keys are the titles of section 6 of docs/spec/ELA_design.md, verbatim and in order: tests/design/test_lists.py reads them from the document. The key is also the label.",
    "OFFLINE": {
      "color": { "$value": "{color.signal.off}", "$type": "color" },
      "shape": { "$value": "{shape.dash}", "$type": "shape" },
      "motion": { "$value": "none", "$type": "pattern" }
    },
    "IDLE": {
      "color": { "$value": "{color.signal.normal}", "$type": "color" },
      "shape": { "$value": "{shape.dot}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.breathe}", "$type": "pattern" }
    },
    "LISTENING": {
      "color": { "$value": "{color.signal.activity}", "$type": "color" },
      "shape": { "$value": "{shape.ring-dot}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.beat}", "$type": "pattern" }
    },
    "THINKING": {
      "color": { "$value": "{color.signal.activity}", "$type": "color" },
      "shape": { "$value": "{shape.arc}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.orbit-eager}", "$type": "pattern" }
    },
    "PLANNING": {
      "color": { "$value": "{color.signal.activity}", "$type": "color" },
      "shape": { "$value": "{shape.ring-dashed}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.step}", "$type": "pattern" }
    },
    "WORKING": {
      "color": { "$value": "{color.signal.activity}", "$type": "color" },
      "shape": { "$value": "{shape.half}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.orbit}", "$type": "pattern" }
    },
    "WAITING": {
      "color": { "$value": "{color.signal.neutral}", "$type": "color" },
      "shape": { "$value": "{shape.ring}", "$type": "shape" },
      "motion": { "$value": "none", "$type": "pattern" }
    },
    "WAITING APPROVAL": {
      "color": { "$value": "{color.signal.wait}", "$type": "color" },
      "shape": { "$value": "{shape.diamond-hollow}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.settle}", "$type": "pattern" }
    },
    "ATTENTION REQUIRED": {
      "color": { "$value": "{color.signal.alert}", "$type": "color" },
