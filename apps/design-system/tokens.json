    },
    "ERROR": {
      "color": { "$value": "{color.signal.fault}", "$type": "color" },
      "shape": { "$value": "{shape.square}", "$type": "shape" },
      "motion": { "$value": "none", "$type": "pattern" }
    },
    "RECOVERING": {
      "color": { "$value": "{color.signal.wait}", "$type": "color" },
      "shape": { "$value": "{shape.arc}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.orbit-slow}", "$type": "pattern" }
    },
    "UPDATING": {
      "color": { "$value": "{color.signal.change}", "$type": "color" },
      "shape": { "$value": "{shape.half}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.orbit-slow}", "$type": "pattern" }
    },
    "EVOLVING": {
      "color": { "$value": "{color.signal.change}", "$type": "color" },
      "shape": { "$value": "{shape.ring-dashed}", "$type": "shape" },
      "motion": { "$value": "{motion.pattern.breathe}", "$type": "pattern" }
    }
  },
  "risk": {
    "$description": "The keys are the values of ela.domain.RiskLevel, verbatim and in order: what the API already answers.",
    "SAFE": { "color": { "$value": "{color.signal.neutral}", "$type": "color" } },
    "LOW": { "color": { "$value": "{color.signal.normal}", "$type": "color" } },
    "MEDIUM": { "color": { "$value": "{color.signal.wait}", "$type": "color" } },
    "HIGH": { "color": { "$value": "{color.signal.alert}", "$type": "color" } },
    "CRITICAL": { "color": { "$value": "{color.signal.fault}", "$type": "color" } }
  },
  "attention": {
    "$description": "The keys are the levels of section 13 of docs/spec/ELA_design.md, verbatim and in order. ADR 0042 decides that these are the names the domain will inherit.",
    "SILENT": { "color": { "$value": "{color.signal.neutral}", "$type": "color" } },
    "NOTIFICATION": { "color": { "$value": "{color.signal.normal}", "$type": "color" } },
    "PRIORITY": { "color": { "$value": "{color.signal.wait}", "$type": "color" } },
    "PHONE CALL": { "color": { "$value": "{color.signal.alert}", "$type": "color" } },
    "EMERGENCY": { "color": { "$value": "{color.signal.fault}", "$type": "color" } }
  },
  "contrast": {
