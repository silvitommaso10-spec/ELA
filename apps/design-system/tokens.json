      { "fg": "{color.text.on-danger}", "bg": "{color.action.danger}" },
      { "fg": "{color.text.on-danger}", "bg": "{color.action.danger-hover}" },
      { "fg": "{color.text.on-danger}", "bg": "{color.action.danger-active}" },
      { "fg": "{color.text.primary}", "bg": "{color.action.secondary}" },
