# Persistence (M2.1). Default: sqlite:///<home>/.ela/ela.db, created on first use.
# Write the URL without driver: the async driver is derived by ELA, alembic uses it as is.
# ELA_DB_URL=sqlite:////Users/you/.ela/ela.db

# Workspace (M5.1). Default: <home>/.ela/workspace, created by the first tool that writes.
# Every path a tool writes is relative to it; notes live under workspace/notes (ADR 0010 §5).
# ELA_WORKSPACE_DIR=/Users/you/.ela/workspace

# Devices (M6.1). Default: 60 seconds. Past it a node is no longer reported available.
# ELA_DEVICE_HEARTBEAT_TTL_SECONDS=60

# Anthropic provider (M7.1, ADR 0020 §3). Without a key the provider registers as UNAVAILABLE
# and answers every call with provider.unavailable, without touching the network: ELA starts.
# The key comes from here and from nowhere else — ANTHROPIC_API_KEY and an `ant auth login`
# profile are deliberately not read, so ELA never spends credentials it was not given.
# ELA_ANTHROPIC_API_KEY=sk-ant-...
# ELA_ANTHROPIC_MODEL=claude-sonnet-5        # balanced by default; a hint chooses another (§25)
# ELA_ANTHROPIC_TIMEOUT_SECONDS=60           # the SDK would wait ten minutes
# ELA_ANTHROPIC_MAX_RETRIES=2                # retries on 429 and 5xx only, never on a 4xx
# ELA_ANTHROPIC_MAX_OUTPUT_TOKENS=4096
