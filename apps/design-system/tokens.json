      { "fg": "{color.border.field}", "bg": "{color.surface.base}" },
      { "fg": "{color.border.field}", "bg": "{color.surface.raised}" },
      { "fg": "{color.focus.ring}", "bg": "{color.surface.base}" },
      { "fg": "{color.focus.ring}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.off}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.off}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.neutral}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.neutral}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.normal}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.normal}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.activity}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.activity}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.wait}", "bg": "{color.surface.base}" },
      { "fg": "{color.signal.wait}", "bg": "{color.surface.raised}" },
      { "fg": "{color.signal.alert}", "bg": "{color.surface.base}" },
